# Postgres connection string from Neon / Supabase / any Postgres.
# On Neon, use the "Pooled connection" string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the /admin page. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Timezone the courts operate in (used for "today" and blocking past slots).
FACILITY_TIMEZONE=Asia/Manila

# Email (optional) — for membership reminder emails, sent through a Gmail account.
# GMAIL_APP_PASSWORD is a 16-character app password, NOT the normal Gmail password:
# Google Account → Security → 2-Step Verification (turn on) → App passwords.
GMAIL_USER=your.club.address@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=NVBC
# Optional: another email provider's SMTP server instead of Gmail (then GMAIL_USER / GMAIL_APP_PASSWORD
# are that provider's login).
# SMTP_HOST=
# SMTP_PORT=465
