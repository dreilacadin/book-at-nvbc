{
  "name": "nvbc-courts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build && node scripts/setup-db.mjs",
    "start": "next start",
    "db:start": "docker-compose up -d",
